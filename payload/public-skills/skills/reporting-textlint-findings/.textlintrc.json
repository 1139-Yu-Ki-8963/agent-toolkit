{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "/^(参考|題名|出典|引用|例|図[0-9]*|表[0-9]*|キャプション|注|注釈|備考|補足)[:：].*$/m"
      ]
    }
  },
  "rules": {
    "preset-ai-words-ja": {
      "no-ai-words": true,
      "no-short-topic-comma": {}
    },
    "@textlint-ja/textlint-rule-preset-ai-writing": true,
    "preset-ja-technical-writing": true
  }
}
