{
  "schemaVersion": 1,
  "purpose": "配る検査が、実際に書かれるコードで違反を止めるかを確かめるための入力集。各検査の自己テストとは別に、現場で書かれる書き方を与えて素通りしないことを見る。",
  "note": "expect は止めてほしいものが violation、通してほしいものが clean。exitCode は違反時に検査が返すべき値で、PreToolUse の block は 2。",
  "cases": [
    {
      "checker": "check-secret-literal-in-code",
      "label": "認証の鍵をコードへ直書き",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/config.js", "content": "const key = \"AKIAIOSFODNN7EXAMPLE\";\n" }
      }
    },
    {
      "checker": "check-secret-literal-in-code",
      "label": "環境変数から読む正しい書き方",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/config.js", "content": "const key = process.env.AWS_KEY;\n" }
      }
    },
    {
      "checker": "check-currency-float-type",
      "label": "金額を小数の型で持つ",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/Order.java", "content": "double price = 100.5;\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "添字の繰り返しの中で問い合わせ",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "for (let i = 0; i < n; i++) {\n  db.query(sql);\n}\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "of の繰り返しの中で問い合わせ",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "for (const item of items) {\n  await db.query(sql, item.id);\n}\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "in の繰り返しの中で問い合わせ",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "for (const k in map) {\n  db.query(sql, k);\n}\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "繰り返しの外で1回だけ問い合わせ",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "const rows = await db.query(sql);\nfor (const r of rows) {\n  use(r);\n}\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "1行の map の中で問い合わせ",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "const r = xs.map((x) => db.query(sql, x.id));\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "1行の forEach の中で外部呼び出し",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "xs.forEach((x) => fetch(x.url));\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "1行の map の中は素の計算",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "const r = xs.map((x) => x.id);\n" }
      }
    },
    {
      "checker": "check-loop-query-call",
      "label": "繰り返しの対象を1回だけ取る",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "for (const x of db.rows) {\n  use(x);\n}\n" }
      }
    },
    {
      "checker": "check-direct-commit-to-integration-branch",
      "label": "作業用の枝の上でコミット",
      "expect": "clean",
      "input": {
        "tool_name": "Bash",
        "cwd": "REPO_ROOT",
        "tool_input": { "command": "git commit -m x" }
      }
    },
    {
      "checker": "check-outbound-call-missing-timeout",
      "label": "外部への呼び出しに待ち時間の上限がない",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/api.js", "content": "const res = await fetch(url);\n" }
      }
    },
    {
      "checker": "check-secret-value-logging",
      "label": "秘密の値を記録へ出す",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/auth.js", "content": "console.log('token=', token);\n" }
      }
    },
    {
      "checker": "check-state-literal-comparison",
      "label": "状態を文字列の直接比較で扱う",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/order.js", "content": "if (order.status === \"shipped\") {\n  ship();\n}\n" }
      }
    },
    {
      "checker": "check-any-type-escape-hatch",
      "label": "型の検査を骨抜きにする",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/api.ts", "content": "const data: any = await res.json();\n" }
      }
    },
    {
      "checker": "check-temp-file-tracked",
      "label": "一時ファイルを置く",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "scratch-note.tmp", "content": "memo\n" }
      }
    },
    {
      "checker": "check-sequential-identifier-naming",
      "label": "通し番号だけで区別する名前",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/form.js", "content": "const item1 = a;\nconst item2 = b;\nconst item3 = c;\n" }
      }
    },
    {
      "checker": "check-doc-heading-addendum",
      "label": "追記の見出しを足す",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/design.md", "content": "# 追記\n本文\n" }
      }
    },
    {
      "checker": "check-full-scan-then-filter",
      "label": "全件取得の直後に絞り込み",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.ts", "content": "const all = await repo.findAll();\nconst active = all.filter((x) => x.active);\n" }
      }
    },
    {
      "checker": "check-full-scan-then-filter",
      "label": "SELECT * のあとで絞り込み",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.js", "content": "const rows = db.query(\"SELECT * FROM users\");\nconst hit = rows.filter(f);\n" }
      }
    },
    {
      "checker": "check-full-scan-then-filter",
      "label": "絞り込みを問い合わせ側で行う",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "src/repo.ts", "content": "const active = await repo.find({ where: { active: true } });\n" }
      }
    },
    {
      "checker": "check-generated-html-manual-edit",
      "label": "生成物の目印を持つHTMLを手で上書き",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "REPO_ROOT/generation-engine/samples/project-portal/図/状態遷移図.html", "content": "<html>手で書き換えた</html>" }
      }
    },
    {
      "checker": "check-generated-html-manual-edit",
      "label": "新しいHTMLを作る",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "REPO_ROOT/docs/no-such-new-page.html", "content": "<html>新規</html>" }
      }
    },
    {
      "checker": "check-ai-config-derivative-manual-edit",
      "label": "派生した規約を直接編集",
      "expect": "violation",
      "input": {
        "tool_name": "Edit",
        "tool_input": { "file_path": ".claude/rules/always/foo/rule.md", "old_string": "a", "new_string": "b" }
      }
    },
    {
      "checker": "check-ai-config-derivative-manual-edit",
      "label": "定義の側を編集",
      "expect": "clean",
      "input": {
        "tool_name": "Edit",
        "tool_input": { "file_path": "docs/rules/always/foo/rule.md", "old_string": "a", "new_string": "b" }
      }
    },
    {
      "checker": "check-release-changelog-entry",
      "label": "変更の履歴なしで公開する",
      "expect": "violation",
      "input": {
        "tool_name": "Bash",
        "cwd": "/",
        "tool_input": { "command": "npm publish" }
      }
    },
    {
      "checker": "check-release-changelog-entry",
      "label": "公開ではないコマンド",
      "expect": "clean",
      "input": {
        "tool_name": "Bash",
        "cwd": "/",
        "tool_input": { "command": "npm install" }
      }
    },
    {
      "checker": "check-glossary-missing-forbidden-terms",
      "label": "使わない語の区分が無い用語一覧",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/用語.md", "content": "| 用語 | 識別子 | 定義 |\n|---|---|---|\n| 受注 | order | 注文を受けることである |\n" }
      }
    },
    {
      "checker": "check-glossary-missing-forbidden-terms",
      "label": "使わない語の区分がある用語一覧",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/用語.md", "content": "| 用語 | 識別子 | 定義 | 使わない語 |\n|---|---|---|---|\n| 受注 | order | 注文を受けることである | オーダー |\n" }
      }
    },
    {
      "checker": "check-business-rule-table-missing-exception",
      "label": "例外の欄が無い判定表",
      "expect": "violation",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/業務規則.md", "content": "| 名前 | 条件 | 結果 |\n|---|---|---|\n| 送料無料の判定 | 金額が1万円以上 | 送料無料 |\n" }
      }
    },
    {
      "checker": "check-business-rule-table-missing-exception",
      "label": "名前と例外の欄がある判定表",
      "expect": "clean",
      "input": {
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/業務規則.md", "content": "| 名前 | 条件 | 結果 | 例外 |\n|---|---|---|---|\n| 送料無料の判定 | 金額が1万円以上 | 送料無料 | 離島は対象外 |\n" }
      }
    },
    {
      "checker": "check-secret-in-command-args",
      "label": "秘密の値をコマンドの引数へ置く",
      "expect": "violation",
      "input": {
        "tool_name": "Bash",
        "tool_input": { "command": "curl -H 'x' --password hunter2 https://example.com" }
      }
    },
    {
      "checker": "check-generated-artifact-staged",
      "label": "生成物を版管理へ入れる",
      "expect": "violation",
      "input": {
        "tool_name": "Bash",
        "tool_input": { "command": "git add node_modules/left-pad/index.js" }
      }
    },
    {
      "checker": "check-secret-filename-staged",
      "label": "秘密を含むファイルを版管理へ入れる",
      "expect": "violation",
      "input": {
        "tool_name": "Bash",
        "tool_input": { "command": "git add .env" }
      }
    }
  ]
}
